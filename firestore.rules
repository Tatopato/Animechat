rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function notificationBaseIsValid() {
      let data = request.resource.data;
      return request.auth != null
        && data.keys().hasOnly([
          'type', 'fromUid', 'fromName', 'createdAt', 'read', 'postId',
          'commentId', 'chatId', 'messageId', 'chatName', 'isGroup',
          'members', 'text'
        ])
        && data.fromUid == request.auth.uid
        && data.fromName is string
        && data.createdAt == request.time
        && data.read == false;
    }

    function validCommentNotification(recipientUid) {
      let data = request.resource.data;
      return data.postId is string
        && data.commentId is string
        && data.text is string
        && data.text.size() <= 280
        && exists(/databases/$(database)/documents/posts/$(data.postId))
        && get(/databases/$(database)/documents/posts/$(data.postId)).data.uid == recipientUid
        && exists(/databases/$(database)/documents/posts/$(data.postId)/comments/$(data.commentId))
        && get(/databases/$(database)/documents/posts/$(data.postId)/comments/$(data.commentId)).data.uid == request.auth.uid;
    }

    function validLikeNotification(recipientUid) {
      let data = request.resource.data;
      return data.postId is string
        && exists(/databases/$(database)/documents/posts/$(data.postId))
        && get(/databases/$(database)/documents/posts/$(data.postId)).data.uid == recipientUid
        && exists(/databases/$(database)/documents/posts/$(data.postId)/likes/$(request.auth.uid));
    }

    function validFriendRequestNotification(recipientUid) {
      return exists(/databases/$(database)/documents/users/$(recipientUid)/friendRequests/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(recipientUid)/friendRequests/$(request.auth.uid)).data.uid == request.auth.uid;
    }

    function validFriendAcceptedNotification(recipientUid) {
      return exists(/databases/$(database)/documents/users/$(recipientUid)/friends/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(recipientUid)/friends/$(request.auth.uid)).data.uid == request.auth.uid;
    }

    function validMessageNotification(recipientUid) {
      let data = request.resource.data;
      let chatPath = /databases/$(database)/documents/chats/$(data.chatId);
      let messagePath = /databases/$(database)/documents/chats/$(data.chatId)/messages/$(data.messageId);
      return data.chatId is string
        && data.messageId is string
        && data.chatName is string
        && data.isGroup is bool
        && data.text is string
        && data.text.size() <= 120
        && data.members is list
        && exists(chatPath)
        && request.auth.uid in get(chatPath).data.members
        && recipientUid in get(chatPath).data.members
        && data.members == get(chatPath).data.members
        && exists(messagePath)
        && get(messagePath).data.uid == request.auth.uid;
    }

    match /users/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, create, update, delete: if request.auth != null && request.auth.uid == uid;

      match /favorites/{id} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      match /friendRequests/{fromUid} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null && request.auth.uid == fromUid
          && request.resource.data.uid == fromUid;
      }
      match /friends/{friendUid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create, update, delete: if request.auth != null
          && (request.auth.uid == uid || request.auth.uid == friendUid);
      }
      match /notifications/{notificationId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow update: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
          && request.resource.data.read is bool;
        allow create: if notificationBaseIsValid()
          && (request.resource.data.type == 'comment' && validCommentNotification(uid)
            || request.resource.data.type == 'like' && validLikeNotification(uid)
            || request.resource.data.type == 'friend_request' && validFriendRequestNotification(uid)
            || request.resource.data.type == 'friend_accepted' && validFriendAcceptedNotification(uid)
            || request.resource.data.type == 'message' && validMessageNotification(uid));
      }
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    match /users/{uid}/chats/{chatId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && exists(/databases/$(database)/documents/chats/$(chatId))
        && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members
        && uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members
        && get(/databases/$(database)/documents/chats/$(chatId)).data.isGroup == true
        && request.resource.data.chatId == chatId
        && request.resource.data.name == get(/databases/$(database)/documents/chats/$(chatId)).data.name
        && request.resource.data.members == get(/databases/$(database)/documents/chats/$(chatId)).data.members;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /publicUsers/{uid} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'displayName', 'bio', 'avatar', 'photoUrl', 'photoBase64', 'bannerBase64'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 160
        && (request.resource.data.get('photoBase64', null) == null
            || request.resource.data.photoBase64.size() <= 140000)
        && (request.resource.data.get('bannerBase64', null) == null
            || request.resource.data.bannerBase64.size() <= 420000);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /posts/{postId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.caption is string
        && request.resource.data.caption.size() <= 280
        && request.resource.data.createdAt == request.time
        && (request.resource.data.get('imageBase64', null) == null
            || request.resource.data.imageBase64.size() < 800000)
        && (request.resource.data.get('animeTitle', null) == null
            || request.resource.data.animeTitle is string)
        && (request.resource.data.get('animeImageUrl', null) == null
            || request.resource.data.animeImageUrl is string);

      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['caption', 'animeId', 'animeTitle', 'animeImageUrl'])
        && request.resource.data.caption is string
        && request.resource.data.caption.size() <= 280
        && (request.resource.data.get('animeId', null) == null
            || request.resource.data.animeId is string)
        && (request.resource.data.get('animeTitle', null) == null
            || request.resource.data.animeTitle is string)
        && (request.resource.data.get('animeImageUrl', null) == null
            || request.resource.data.animeImageUrl is string);

      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;

      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 280
          && request.resource.data.createdAt == request.time;
        allow update, delete: if request.auth != null
          && resource.data.uid == request.auth.uid;
      }

      match /likes/{likeUid} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.auth.uid == likeUid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.createdAt == request.time;
        allow delete: if request.auth != null && request.auth.uid == likeUid;
        allow update: if false;
      }
    }

    match /chats/{chatId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.members;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.members
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members is list
        && request.resource.data.members.size() <= 32
        && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'members', 'memberNames', 'updatedAt', 'lastMessage'
          ])
          || (resource.data.isGroup == true
            && request.resource.data.isGroup == true
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'members', 'memberNames', 'updatedAt', 'lastMessage', 'name', 'photoBase64'
            ])
            && request.resource.data.name is string
            && request.resource.data.name.size() > 0
            && request.resource.data.name.size() <= 60
            && (request.resource.data.get('photoBase64', null) == null
              || (request.resource.data.photoBase64 is string
                && request.resource.data.photoBase64.size() <= 140000)))
        );
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members is list
        && request.resource.data.members.size() >= 2
        && request.resource.data.members.size() <= 32;
      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        allow create: if request.auth != null
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt == request.time
          && (request.resource.data.text.size() > 0
              || request.resource.data.get('attachmentBase64', null) != null)
          && (request.resource.data.get('attachmentBase64', null) == null
              || request.resource.data.attachmentBase64.size() <= 800000)
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        allow update, delete: if false;
      }
    }
  }
}
